AddDefaultCharset utf-8
ErrorDocument 404 /404.html

RewriteEngine On
RewriteRule (^|/)\.git(/|$) - [R=404,L]
RewriteRule ^README\.txt$ - [R=404,L]
RewriteCond %{HTTP_HOST} ^blog\. [NC]
RewriteRule ^(agentic-commerce-ar|ar-customer-education|ar-product-packaging|augmented-reality-education|augmented-reality-retail-nrf-2026|benefits-ar-architecture|choosing-an-xr-agency|difference-ar-mr-vr-xr|fudge-ing-awesome|how-ar-can-help-create-engaging-product-demos|kpis-xr-marketing-campaign|small-ar-studio-advantages|top-ar-niches|virtual-try-ons-ar|xr-trends-a-glimpse-into-the-future)/?$ https://virtualfudge.com/#blog-$1 [NE,L,R=301]
RewriteCond %{HTTP_HOST} ^blog\. [NC]
RewriteRule ^ https://virtualfudge.com/#blog [NE,L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
